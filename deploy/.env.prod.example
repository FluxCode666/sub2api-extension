# =============================================================================
# Sub2API Extension - 生产环境变量示例
# =============================================================================
# 复制此文件为 .env.prod 并填入实际值，再执行：
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
#
# 这是 deploy/docker-compose.prod.yml 的环境变量来源。
# 生产环境不含 PostgreSQL 镜像——DATABASE_* 指向外部数据库。
# =============================================================================

# ---- 镜像配置 ----
# GHCR 镜像地址。CI 部署时自动更新 AUX_IMAGE_TAG 为本次版本号。
# 默认 owner 为 GitHub 仓库所有者（替换 your-org 为实际 owner）。
AUX_IMAGE=ghcr.io/your-org/sub2api-extension
# 镜像标签。首次部署用 latest；之后 CI 部署会自动写入具体版本号（如 1.0.0）。
AUX_IMAGE_TAG=latest

# 容器名称。测试环境使用 aux-backend-test，避免同机部署时名称冲突。
AUX_CONTAINER_NAME=aux-backend

# ---- 公网访问配置 ----
# NGINX 的 server_name、证书路径和 sub2api iframe URL 使用此域名。
# 该变量供部署文档与运维脚本使用，NGINX 配置中的 server_name 仍需替换为实际域名。
AUX_PUBLIC_HOST=aux.example.com

# ---- 附属系统 HTTP 端口（宿主机映射）----
AUX_SERVER_PORT=8787

# ---- 绑定地址 ----
# 宿主机 NGINX 反代时保持本机绑定，避免 8787 端口绕过 NGINX 暴露公网。
BIND_HOST=127.0.0.1

# ---- 外部 PostgreSQL（不在本 compose 内运行）----
# 指向外部数据库实例。同 Docker 网络用服务名（如 sub2api-postgres）；否则用 IP/域名。
# 例：复用 sub2api 的 postgres → DATABASE_HOST=sub2api-postgres, DATABASE_DBNAME=sub2api
#     或独立数据库   → DATABASE_HOST=10.0.1.5, DATABASE_DBNAME=auxdb
DATABASE_HOST=sub2api-postgres
DATABASE_PORT=5432
DATABASE_USER=sub2api
DATABASE_PASSWORD=change-me-to-a-strong-password
DATABASE_DBNAME=sub2api
# 同网络内通信用 disable；公网/跨网用 require
DATABASE_SSLMODE=disable

# ---- sub2api 对接 ----
# sub2api 后端地址。同 Docker 网络部署用 http://sub2api:8080（服务名解析）。
# 若附属系统与 sub2api 不在同一网络，用 sub2api 的公网域名（如 https://sub2api.example.com）。
SUB2API_BASE_URL=http://sub2api:8080

# ---- 附属系统 JWT 配置（管理员会话签名）----
# 重要：设置固定 JWT_SECRET，避免容器重启后管理员会话失效。
# 生成一个安全密钥: openssl rand -hex 32
AUX_JWT_SECRET=
AUX_JWT_EXPIRE_HOUR=24

# ---- 上传图片文件目录（与 /app/data 持久卷一致）----
AUX_ASSET_DIR=/app/data/assets

# ---- 运行模式 ----
# release 生产模式（gin.ReleaseMode）；debug 开发模式
SERVER_MODE=release

# ---- 日志轮转 ----
DOCKER_LOG_MAX_SIZE=100m
DOCKER_LOG_MAX_FILE=5

# ---- 时区 ----
TZ=Asia/Shanghai
