# =============================================================================
# Sub2API Extension - Environment Variables Example
# =============================================================================
# 复制此文件为 .env.dev 并填入实际值，再执行 docker compose -f docker-compose.dev.yml --env-file .env.dev up -d。
#
# 这是 deploy/docker-compose.dev.yml 的环境变量来源。
# =============================================================================

# ---- 附属系统 HTTP 端口（宿主机映射）----
# 浏览器 iframe 使用 SUB2API_EXTENSION_PUBLIC_URL；容器内部不要把
# http://aux-backend:8787 当作浏览器地址。宿主机访问用此端口：curl http://localhost:8787/health
SUB2API_EXTENSION_SERVER_PORT=8787

# ---- 绑定地址 ----
BIND_HOST=0.0.0.0

# ---- 附属系统自有 PostgreSQL ----
# 独立于 sub2api 的 postgres，承载埋点表（page_view / feature_click）。
SUB2API_EXTENSION_POSTGRES_USER=aux
# 不要提交真实密码；启动前替换为本地开发密码。
SUB2API_EXTENSION_POSTGRES_PASSWORD=
SUB2API_EXTENSION_POSTGRES_DB=auxdb
# 宿主机调试端口（仅 127.0.0.1）
SUB2API_EXTENSION_POSTGRES_HOST_PORT=15433

# ---- sub2api 对接 ----
# sub2api 后端地址。同 Docker 网络部署用 http://sub2api:8080（服务名解析）。
# 若附属系统与 sub2api 不在同一网络，用 sub2api 的公网域名（如 https://sub2api.example.com）。
SUB2API_BASE_URL=http://sub2api:8080

# sub2api Docker Compose 网络名。
# 在 /Users/duegin/project/sub2api/deploy 目录使用默认 project name（deploy）
# 启动 docker-compose.dev.yml 时，实际网络名是 deploy_sub2api-network。
# 如果使用 `docker compose --project-name <name>`，改为
# <name>_sub2api-network。该网络必须先由 sub2api Compose 创建。
SUB2API_DOCKER_NETWORK=deploy_sub2api-network

# ---- sub2api 数据库（页面上架与首字延迟看板直读）----
# 首字延迟看板与页面上架都从此 PostgreSQL 连接读取/同步数据；
# 与附属系统自己的 PostgreSQL 配置完全不同。
# sub2api dev/test Compose 的 PostgreSQL 服务名是 postgres；不要填 aux-postgres。
SUB2API_DATABASE_HOST=postgres
SUB2API_DATABASE_PORT=5432
SUB2API_DATABASE_USER=sub2api
# 必须与 sub2api/deploy/.env 中的 POSTGRES_PASSWORD 一致。
SUB2API_DATABASE_PASSWORD=
SUB2API_DATABASE_DBNAME=sub2api
SUB2API_DATABASE_SSLMODE=disable
# 浏览器可访问的 sub2api-extension 地址，用于生成菜单 iframe URL。
SUB2API_EXTENSION_PUBLIC_URL=http://localhost:8787

# ---- 附属系统 JWT 配置（管理员会话签名）----
# 重要：设置固定 JWT_SECRET，避免容器重启后管理员会话失效。
# 生成一个安全密钥: openssl rand -hex 32
SUB2API_EXTENSION_JWT_SECRET=
SUB2API_EXTENSION_JWT_EXPIRE_HOUR=24

# ---- 上传图片文件目录（Compose 已挂载 /app/data 持久卷）----
# 通常保持默认值；数据库只保存此目录下的相对文件路径。
SUB2API_EXTENSION_ASSET_DIR=/app/data/assets

# ---- 运行模式 ----
# release 生产模式（gin.ReleaseMode）；debug 开发模式
SERVER_MODE=release

# ---- 时区 ----
TZ=Asia/Shanghai
