# =============================================================================
# Aux Content System - Environment Variables Example
# =============================================================================
# 复制此文件为 .env 并填入实际值，再执行 docker compose up -d。
#
# 这是 deploy/docker-compose.yml 的环境变量来源。
# =============================================================================

# ---- 附属系统 HTTP 端口（宿主机映射）----
# sub2api 经 iframe 访问附属系统时，同网络用 http://aux-backend:8787（容器内固定）。
# 宿主机访问用此端口：curl http://localhost:8787/health
AUX_SERVER_PORT=8787

# ---- 绑定地址 ----
BIND_HOST=0.0.0.0

# ---- 附属系统自有 PostgreSQL ----
# 独立于 sub2api 的 postgres，承载埋点表（page_view / feature_click）。
AUX_POSTGRES_USER=aux
AUX_POSTGRES_PASSWORD=change-me-to-a-strong-password
AUX_POSTGRES_DB=auxdb
# 宿主机调试端口（仅 127.0.0.1）
AUX_POSTGRES_HOST_PORT=15433

# ---- sub2api 对接 ----
# sub2api 后端地址。同 Docker 网络部署用 http://sub2api:8080（服务名解析）。
# 若附属系统与 sub2api 不在同一网络，用 sub2api 的公网域名（如 https://sub2api.example.com）。
SUB2API_BASE_URL=http://sub2api:8080

# Admin API Key：在 sub2api 后台「安全」tab → "Admin API Key" 卡片生成（64 字符 hex）。
# 附属系统后端用此 key 读 sub2api 数据（如 dashboard stats）。
# 使用方式：请求头 x-api-key: <admin-api-key> 调 sub2api /api/v1/admin/*。
# 注意：不能执行需要 step-up 2FA 的敏感操作，但只读端点没问题。
SUB2API_ADMIN_API_KEY=

# ---- 附属系统 JWT 配置（管理员会话签名）----
# 重要：设置固定 JWT_SECRET，避免容器重启后管理员会话失效。
# 生成一个安全密钥: openssl rand -hex 32
AUX_JWT_SECRET=
AUX_JWT_EXPIRE_HOUR=24

# ---- 运行模式 ----
# release 生产模式（gin.ReleaseMode）；debug 开发模式
SERVER_MODE=release

# ---- 时区 ----
TZ=Asia/Shanghai
