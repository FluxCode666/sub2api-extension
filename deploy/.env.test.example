# =============================================================================
# Sub2API Extension - 测试环境变量示例
# =============================================================================
# 复制为测试服务器部署目录中的 .env.test：
#   cp .env.test.example .env.test
#
# 测试流水线使用同一个 docker-compose.yml，但数据库、JWT、sub2api、域名和
# 持久卷都应与生产环境隔离。不得复用生产数据库或生产 JWT_SECRET。
# =============================================================================

# ---- 镜像配置 ----
SUB2API_EXTENSION_IMAGE=ghcr.io/your-org/sub2api-extension
SUB2API_EXTENSION_IMAGE_TAG=test-latest
SUB2API_EXTENSION_CONTAINER_NAME=aux-backend-test

# ---- 宿主机映射 ----
# 独立测试服务器可使用 8787；若测试与生产同机，请改用未占用端口并同步 NGINX upstream。
SUB2API_EXTENSION_SERVER_PORT=8787
BIND_HOST=127.0.0.1

# ---- 测试 PostgreSQL ----
DATABASE_HOST=test-postgres
DATABASE_PORT=5432
DATABASE_USER=aux_test
DATABASE_PASSWORD=change-me-to-a-test-password
DATABASE_DBNAME=aux_test
DATABASE_SSLMODE=disable

# ---- 测试 sub2api ----
SUB2API_BASE_URL=http://sub2api-test:8080

# ---- 测试 sub2api 数据库（页面上架同步 custom_menu_items）----
SUB2API_DATABASE_HOST=postgres-test
SUB2API_DATABASE_PORT=5432
SUB2API_DATABASE_USER=sub2api
SUB2API_DATABASE_PASSWORD=
SUB2API_DATABASE_DBNAME=sub2api
SUB2API_DATABASE_SSLMODE=disable
SUB2API_EXTENSION_PUBLIC_URL=

# ---- 测试管理员会话 ----
# 必须与生产使用不同值：openssl rand -hex 32
SUB2API_EXTENSION_JWT_SECRET=
SUB2API_EXTENSION_JWT_EXPIRE_HOUR=24

# ---- 上传资源根目录（图片在 photos/，发票在 invoices/）----
SUB2API_EXTENSION_ASSET_DIR=/app/data/assets

# ---- 运行与日志 ----
SERVER_MODE=release
DOCKER_LOG_MAX_SIZE=100m
DOCKER_LOG_MAX_FILE=5
TZ=Asia/Shanghai
