# =============================================================================
# Sub2API Extension - 测试环境变量示例
# =============================================================================
# 复制为测试服务器部署目录中的 .env.test：
#   cp .env.test.example .env.test
#
# 测试流水线使用同一个 docker-compose.yml，但数据库、JWT、sub2api、域名和
# 持久卷都应与生产环境隔离。不得复用生产数据库或生产 JWT_SECRET。
# =============================================================================

# ---- 镜像配置 ----
AUX_IMAGE=ghcr.io/your-org/sub2api-extension
AUX_IMAGE_TAG=test-latest
AUX_CONTAINER_NAME=aux-backend-test

# ---- 测试环境公网域名 ----
# 由测试服务器 NGINX 使用；将 deploy/nginx 模板复制一份并替换为该域名。
AUX_PUBLIC_HOST=aux-test.example.com

# ---- 宿主机映射 ----
# 独立测试服务器可使用 8787；若测试与生产同机，请改用未占用端口并同步 NGINX upstream。
AUX_SERVER_PORT=8787
BIND_HOST=127.0.0.1

# ---- 测试 PostgreSQL ----
DATABASE_HOST=test-postgres
DATABASE_PORT=5432
DATABASE_USER=aux_test
DATABASE_PASSWORD=change-me-to-a-test-password
DATABASE_DBNAME=aux_test
DATABASE_SSLMODE=disable

# ---- 测试 sub2api ----
SUB2API_BASE_URL=http://sub2api-test:8080

# ---- 测试管理员会话 ----
# 必须与生产使用不同值：openssl rand -hex 32
AUX_JWT_SECRET=
AUX_JWT_EXPIRE_HOUR=24

# ---- 上传文件持久化 ----
AUX_ASSET_DIR=/app/data/assets

# ---- 运行与日志 ----
SERVER_MODE=release
DOCKER_LOG_MAX_SIZE=100m
DOCKER_LOG_MAX_FILE=5
TZ=Asia/Shanghai
